<Window x:Class="csharp_wpf_conversor_moedas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:csharp_wpf_conversor_moedas"
        mc:Ignorable="d"
        Title="Conversor Moedas"
        Width="360"
        Height="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Cursor="">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Conversor Moedas"
                   FontWeight="Bold"
                   FontSize="18"
                   Foreground="Black"
                   HorizontalAlignment="Center"
                   Margin="0,16,0,32" />

        <Grid Grid.Row="1" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image x:Name="imgBandeiraOrigem"
                   Grid.Column="0"
                   Width="32"
                   Height="32"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Source="{Binding ElementName=cmbMoedaOrigem, Path=SelectedItem.Bandeira}" />

            <ComboBox x:Name="cmbMoedaOrigem"
                      Grid.Column="1"
                      MinWidth="80"
                      Height="40"
                      Margin="8,0,8,0"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding ListaMonetaria}"
                      DisplayMemberPath="Sigla" />

            <TextBox x:Name="txtValorOrigem"
                     Grid.Column="2"
                     Height="40"
                     VerticalContentAlignment="Center" />
        </Grid>

        <Button x:Name="btnInverter"
                Grid.Row="2"
                Style="{StaticResource ConverterButtonStyle}"
                Margin="0,12,0,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="InverterBtn_click">
            <Image Source="{StaticResource ImgConverter}"
                   Width="32"
                   Height="32" />
        </Button>

        <Grid Grid.Row="3" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image x:Name="imgBandeiraDestino"
                   Grid.Column="0"
                   Width="32"
                   Height="32"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Source="{Binding ElementName=cmbMoedaDestino, Path=SelectedItem.Bandeira}" />

            <ComboBox x:Name="cmbMoedaDestino"
                      Grid.Column="1"
                      MinWidth="80"
                      Height="40"
                      Margin="8,0,8,0"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding ListaMonetaria}"
                      DisplayMemberPath="Sigla" />

            <TextBox x:Name="txtValorDestino"
                     Grid.Column="2"
                     Height="40"
                     VerticalContentAlignment="Center" />
        </Grid>

        <Button x:Name="btnConverter"
                Grid.Row="4"
                Content="Converter"
                Height="36"
                Margin="0,32,0,0" />
    </Grid>
</Window>